{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cambot.local/schema/machine-tending-event-2.0.json",
  "title": "CAM-BOT machine-tending event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "trial_id", "sequence",
    "timestamp_utc", "monotonic_elapsed_s", "state", "target",
    "reachability", "decision", "action", "result", "details"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "monotonic_elapsed_s": {"type": "number", "minimum": 0},
    "state": {"type": "string", "minLength": 1},
    "target": {"type": ["string", "null"]},
    "reachability": {"type": ["string", "null"]},
    "decision": {"type": ["string", "null"]},
    "action": {"type": "string", "minLength": 1},
    "result": {"type": "string", "minLength": 1},
    "details": {"type": "object"}
  }
}
