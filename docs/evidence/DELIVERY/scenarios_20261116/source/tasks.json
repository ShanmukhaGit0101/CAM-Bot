{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CAM-BOT: 00 Check environment",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/tools/workbench.sh",
        "doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "CAM-BOT: 01 Build visual demo",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/tools/workbench.sh",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CAM-BOT: 02 Test core packages",
