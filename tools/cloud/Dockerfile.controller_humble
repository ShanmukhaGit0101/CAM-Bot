# Headless Task-7 controller testbed; no robot network driver or RViz required.
FROM ros:humble-ros-base-jammy@sha256:d9bcf2e6f72df127fdee07048c2e87b1b4b9a59a74af0592f4489fc2844aa855
RUN --mount=type=secret,id=ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/ca update && \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::https::CaInfo=/run/secrets/ca install -y --no-install-recommends \
    ros-humble-controller-manager ros-humble-hardware-interface \
    ros-humble-joint-trajectory-controller ros-humble-joint-state-broadcaster \
    ros-humble-ur-description ros-humble-robot-state-publisher ros-humble-xacro \
    ros-humble-moveit-msgs ros-humble-tf2-ros \
    python3-colcon-common-extensions python3-pytest python3-yaml git-lfs \
    ros-humble-ament-copyright ros-humble-ament-flake8 ros-humble-ament-pep257 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/CAM-BOT
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
